Task 1: Set Rate Limits for Service Endpoints
Subtask 1.1: Deploy Sample Applications
First, let's deploy sample applications that we'll use to test rate limiting.

Create a new project for the lab:
oc new-project rate-limiting-lab
oc label namespace rate-limiting-lab istio-injection=enabled
Deploy a sample backend service:
# Create backend-service.yaml
cat << 'EOF' > backend-service.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend-service
  namespace: rate-limiting-lab
spec:
  replicas: 2
  selector:
    matchLabels:
      app: backend-service
      version: v1
  template:
    metadata:
      labels:
        app: backend-service
        version: v1
    spec:
      containers:
      - name: backend
        image: httpd:2.4
        ports:
        - containerPort: 80
        resources:
          requests:
            memory: "64Mi"
            cpu: "50m"
          limits:
            memory: "128Mi"
            cpu: "100m"
---
apiVersion: v1
kind: Service
metadata:
  name: backend-service
  namespace: rate-limiting-lab
spec:
  selector:
    app: backend-service
  ports:
  - port: 80
    targetPort: 80
    name: http
EOF
Apply the backend service configuration:
oc apply -f backend-service.yaml
Deploy a client application for testing:
# Create client-app.yaml
cat << 'EOF' > client-app.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: client-app
  namespace: rate-limiting-lab
spec:
  replicas: 1
  selector:
    matchLabels:
      app: client-app
  template:
    metadata:
      labels:
        app: client-app
    spec:
      containers:
      - name: client
        image: curlimages/curl:latest
        command: ["/bin/sh"]
        args: ["-c", "while true; do sleep 3600; done"]
