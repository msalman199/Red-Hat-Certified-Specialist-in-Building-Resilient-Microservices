Subtask 1.2: Build the Traffic Mirror Service
The mirror is a small asynchronous Python proxy. It always returns the production response to the caller, and separately fires a copy of the same request at staging in the background so staging performance can be observed without ever affecting what a real user sees.

Create the mirror application:
cat > config/traffic-mirror.py << 'EOF'
#!/usr/bin/env python3
"""
Traffic Mirroring Proxy for Dark Launches.
Forwards every request to production for the real response, and
mirrors a copy of the same request to staging in the background.
"""

import asyncio
import logging
import json
from datetime import datetime

import aiohttp
from aiohttp import web

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("traffic-mirror")

PRODUCTION_URL = "http://production-app:80"
STAGING_URL = "http://staging-app:80"

stats = {
    "total_requests": 0,
    "production_requests": 0,
    "staging_requests": 0,
    "errors": 0,
}


async def forward_to_staging(method, path, headers, body):
    """Fire-and-forget mirror copy sent to staging."""
    url = f"{STAGING_URL}{path}"
    try:
        async with aiohttp.ClientSession() as session:
            async with session.request(
                method, url, headers=headers, data=body,
                timeout=aiohttp.ClientTimeout(total=10)
            ) as response:
                stats["staging_requests"] += 1
                logger.info("Mirrored to staging: %s %s -> %s", method, path, response.status)
    except Exception as exc:
        stats["errors"] += 1
        logger.error("Error mirroring to staging: %s", exc)


async def handle_request(request):
    stats["total_requests"] += 1

    method = request.method
    path = request.path_qs
    headers = dict(request.headers)
    headers.pop("Host", None)
    headers.pop("Connection", None)

    body = await request.read()

    # Send the mirrored copy to staging without waiting for it.
    asyncio.create_task(forward_to_staging(method, path, dict(headers), body))

    # Forward to production and return that response to the caller.
    url = f"{PRODUCTION_URL}{path}"
    try:
        async with aiohttp.ClientSession() as session:
            async with session.request(
                method, url, headers=headers, data=body,
                timeout=aiohttp.ClientTimeout(total=10)
            ) as response:
                stats["production_requests"] += 1
                response_body = await response.read()
                response_headers = dict(response.headers)
                response_headers.pop("Connection", None)
                response_headers.pop("Transfer-Encoding", None)
                return web.Response(
                    body=response_body,
                    status=response.status,
                    headers=response_headers,
                )
    except Exception as exc:
        stats["errors"] += 1
        logger.error("Error forwarding to production: %s", exc)
        return web.Response(
            text=json.dumps({"error": "Service temporarily unavailable"}),
            status=503,
            content_type="application/json",
        )


async def stats_handler(request):
    payload = dict(stats)
    payload["timestamp"] = datetime.now().isoformat()
    return web.Response(text=json.dumps(payload, indent=2), content_type="application/json")


def create_app():
    app = web.Application()
    app.router.add_get("/mirror-stats", stats_handler)
    app.router.add_route("*", "/{path:.*}", handle_request)
    return app


if __name__ == "__main__":
    web.run_app(create_app(), host="0.0.0.0", port=8000)
EOF
Create the Dockerfile for the mirror service:
cat > config/Dockerfile.mirror << 'EOF'
FROM python:3.11-alpine

WORKDIR /app

RUN pip install --no-cache-dir aiohttp

COPY traffic-mirror.py /app/

EXPOSE 8000

CMD ["python", "traffic-mirror.py"]
EOF
Create the complete docker-compose.yml. This single file defines production, staging, and the traffic mirror together, so there is one authoritative version of the stack:
cat > docker-compose.yml << 'EOF'
version: '3.8'

services:
  production-app:
    image: nginx:alpine
    container_name: production-app
    ports:
      - "8080:80"
    volumes:
      - ./production:/usr/share/nginx/html
      - ./config/production-nginx.conf:/etc/nginx/conf.d/default.conf
    networks:
      - app-network

  staging-app:
    image: nginx:alpine
    container_name: staging-app
    ports:
      - "8081:80"
    volumes:
      - ./staging:/usr/share/nginx/html
      - ./config/staging-nginx.conf:/etc/nginx/conf.d/default.conf
    networks:
      - app-network

  traffic-mirror:
    build:
      context: ./config
      dockerfile: Dockerfile.mirror
    container_name: traffic-mirror
    ports:
      - "8000:8000"
    depends_on:
      - production-app
      - staging-app
    networks:
      - app-network

networks:
  app-network:
    driver: bridge
EOF
