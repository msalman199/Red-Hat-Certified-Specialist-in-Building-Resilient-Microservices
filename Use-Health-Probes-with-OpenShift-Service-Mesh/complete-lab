        version: v1
    spec:
      containers:
      - name: health-demo
        image: quay.io/redhattraining/health-probe-demo:latest
        ports:
        - containerPort: 8080
        env:
        - name: STARTUP_DELAY
          value: "10"
        - name: READINESS_DELAY
          value: "5"
        livenessProbe:
          httpGet:
            path: /health/live
            port: 8080
            scheme: HTTP
          initialDelaySeconds: 15
          periodSeconds: 10
