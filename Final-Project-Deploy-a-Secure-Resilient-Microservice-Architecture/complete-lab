Task 2: Implement Traffic Management
Subtask 2.1: Create Gateway and Virtual Service
Configure ingress traffic management for the application.

# Create the gateway for external traffic
cat << 'EOF' > bookstore-gateway.yaml
apiVersion: networking.istio.io/v1beta1
kind: Gateway
metadata:
  name: bookstore-gateway
  namespace: bookstore-app
spec:
  selector:
    istio: ingressgateway
  servers:
  - port:
      number: 80
      name: http
      protocol: HTTP
    hosts:
    - bookstore.example.com
    - "*"
---
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: bookstore-vs
  namespace: bookstore-app
spec:
  hosts:
  - bookstore.example.com
  - "*"
  gateways:
  - bookstore-gateway
  http:
  - match:
    - uri:
        prefix: /
    route:
    - destination:
        host: frontend
        port:
          number: 8080
EOF

# Apply the gateway configuration
oc apply -f bookstore-gateway.yaml
Subtask 2.2: Implement Canary Deployment
Configure traffic splitting between different versions of the reviews service.

# Create destination rules for version-based routing
cat << 'EOF' > reviews-destination-rule.yaml
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: reviews-destination-rule
  namespace: bookstore-app
spec:
  host: reviews-service
  subsets:
  - name: v1
    labels:
      version: v1
  - name: v2
    labels:
      version: v2
---
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: reviews-vs
  namespace: bookstore-app
spec:
  hosts:
  - reviews-service
  http:
  - match:
    - headers:
        user-type:
          exact: premium
    route:
    - destination:
        host: reviews-service
        subset: v2
      weight: 100
  - route:
    - destination:
        host: reviews-service
        subset: v1
      weight: 80
    - destination:
        host: reviews-service
        subset: v2
      weight: 20
EOF

# Apply the traffic management rules
oc apply -f reviews-destination-rule.yaml
Subtask 2.3: Configure Load Balancing
Implement advanced load balancing strategies.

# Update destination rule with load balancing configuration
cat << 'EOF' > books-destination-rule.yaml
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: books-destination-rule
  namespace: bookstore-app
spec:
  host: books-service
  trafficPolicy:
    loadBalancer:
      simple: LEAST_CONN
    connectionPool:
      tcp:
        maxConnections: 10
      http:
        http1MaxPendingRequests: 10
        maxRequestsPerConnection: 2
    outlierDetection:
      consecutiveErrors: 3
      interval: 30s
      baseEjectionTime: 30s
      maxEjectionPercent: 50
EOF

# Apply the load balancing configuration
oc apply -f books-destination-rule.yaml
Task 3: Implement Security Features
Subtask 3.1: Enable Mutual TLS
Configure automatic mutual TLS for service-to-service communication.

# Create PeerAuthentication for strict mTLS
cat << 'EOF' > peer-authentication.yaml
apiVersion: security.istio.io/v1beta1
kind: PeerAuthentication
metadata:
  name: default
  namespace: bookstore-app
spec:
  mtls:
    mode: STRICT
EOF

# Apply the mTLS configuration
oc apply -f peer-authentication.yaml

# Verify mTLS is working
istioctl authn tls-check frontend.bookstore-app.svc.cluster.local
Subtask 3.2: Implement Authorization Policies
Create fine-grained access control policies.

# Create authorization policy for the books service
cat << 'EOF' > books-authz-policy.yaml
apiVersion: security.istio.io/v1beta1
kind: AuthorizationPolicy
metadata:
  name: books-policy
  namespace: bookstore-app
spec:
  selector:
    matchLabels:
      app: books-service
  rules:
  - from:
    - source:
        principals: ["cluster.local/ns/bookstore-app/sa/default"]
    to:
    - operation:
        methods: ["GET", "POST"]
  - from:
    - source:
        principals: ["cluster.local/ns/bookstore-app/sa/frontend-sa"]
    to:
    - operation:
        methods: ["GET"]
---
apiVersion: security.istio.io/v1beta1
kind: AuthorizationPolicy
metadata:
  name: reviews-policy
  namespace: bookstore-app
spec:
  selector:
    matchLabels:
      app: reviews-service
  rules:
  - from:
    - source:
        principals: ["cluster.local/ns/bookstore-app/sa/default"]
    to:
    - operation:
        methods: ["GET"]
    when:
    - key: request.headers[user-id]
      notValues: [""]
EOF

# Apply authorization policies
oc apply -f books-authz-policy.yaml
Subtask 3.3: Configure Request Authentication
Implement JWT token validation for external requests.

# Create RequestAuthentication for JWT validation
cat << 'EOF' > request-authentication.yaml
apiVersion: security.istio.io/v1beta1
kind: RequestAuthentication
metadata:
  name: jwt-auth
  namespace: bookstore-app
spec:
  selector:
    matchLabels:
      app: frontend
  jwtRules:
  - issuer: "https://auth.bookstore.com"
    jwksUri: "https://auth.bookstore.com/.well-known/jwks.json"
    audiences:
    - "bookstore-api"
---
apiVersion: security.istio.io/v1beta1
kind: AuthorizationPolicy
metadata:
  name: require-jwt
  namespace: bookstore-app
spec:
  selector:
    matchLabels:
      app: frontend
  rules:
  - from:
    - source:
        requestPrincipals: ["https://auth.bookstore.com/*"]
    to:
    - operation:
        paths: ["/api/*"]
  - to:
    - operation:
        paths: ["/health", "/ready", "/"]
EOF

# Apply JWT authentication
oc apply -f request-authentication.yaml
Task 4: Implement Resilience Patterns
Subtask 4.1: Configure Circuit Breaker
Implement circuit breaker pattern to handle service failures.

# Update books destination rule with circuit breaker
cat << 'EOF' > books-circuit-breaker.yaml
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: books-circuit-breaker
  namespace: bookstore-app
spec:
  host: books-service
  trafficPolicy:
    connectionPool:
      tcp:
        maxConnections: 5
      http:
        http1MaxPendingRequests: 5
        maxRequestsPerConnection: 2
        consecutiveGatewayErrors: 3
        interval: 30s
        baseEjectionTime: 30s
    outlierDetection:
      consecutiveErrors: 3
      interval: 30s
      baseEjectionTime: 30s
      maxEjectionPercent: 50
      minHealthPercent: 50
EOF

# Apply circuit breaker configuration
oc apply -f books-circuit-breaker.yaml
Subtask 4.2: Implement Retry and Timeout Policies
Configure automatic retries and timeouts for resilient communication.

# Create virtual service with retry and timeout policies
cat << 'EOF' > resilience-policies.yaml
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: books-resilience
  namespace: bookstore-app
spec:
  hosts:
  - books-service
  http:
  - route:
    - destination:
        host: books-service
    timeout: 10s
    retries:
      attempts: 3
      perTryTimeout: 3s
      retryOn: 5xx,reset,connect-failure,refused-stream
---
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: reviews-resilience
  namespace: bookstore-app
spec:
  hosts:
  - reviews-service
  http:
  - route:
    - destination:
        host: reviews-service
        subset: v1
      weight: 80
    - destination:
        host: reviews-service
        subset: v2
      weight: 20
    timeout: 5s
    retries:
      attempts: 2
      perTryTimeout: 2s
      retryOn: 5xx,gateway-error
EOF

# Apply resilience policies
oc apply -f resilience-policies.yaml
Subtask 4.3: Implement Fault Injection
Configure fault injection for testing resilience.

# Create fault injection for testing
cat << 'EOF' > fault-injection.yaml
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: books-fault-injection
  namespace: bookstore-app
spec:
  hosts:
  - books-service
  http:
  - match:
    - headers:
        test-fault:
          exact: "delay"
    fault:
      delay:
        percentage:
          value: 50
        fixedDelay: 5s
    route:
    - destination:
        host: books-service
  - match:
    - headers:
        test-fault:
          exact: "abort"
    fault:
      abort:
        percentage:
          value: 30
        httpStatus: 503
    route:
    - destination:
        host: books-service
  - route:
    - destination:
        host: books-service
EOF

# Apply fault injection (for testing only)
oc apply -f fault-injection.yaml
