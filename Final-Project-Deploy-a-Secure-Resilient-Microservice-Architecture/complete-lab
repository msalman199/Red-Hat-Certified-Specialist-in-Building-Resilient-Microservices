Task 1: Deploy the Microservice Application
Subtask 1.1: Create Project and Enable Service Mesh
First, we'll create a new project and enable it for service mesh.

# Create a new project for our microservice application
oc new-project bookstore-app

# Label the namespace to enable automatic sidecar injection
oc label namespace bookstore-app istio-injection=enabled

# Verify the label was applied
oc get namespace bookstore-app --show-labels
Subtask 1.2: Deploy the Database Service
Deploy a PostgreSQL database that will serve as the backend for our bookstore application.

# Create the database deployment
cat << 'EOF' > database-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: database
  namespace: bookstore-app
spec:
  replicas: 1
  selector:
    matchLabels:
      app: database
      version: v1
  template:
    metadata:
      labels:
        app: database
        version: v1
    spec:
      containers:
      - name: postgres
        image: postgres:13
        ports:
        - containerPort: 5432
        env:
        - name: POSTGRES_DB
          value: bookstore
        - name: POSTGRES_USER
          value: bookuser
        - name: POSTGRES_PASSWORD
          value: bookpass123
        resources:
          requests:
            memory: "256Mi"
            cpu: "250m"
          limits:
            memory: "512Mi"
            cpu: "500m"
---
apiVersion: v1
kind: Service
metadata:
  name: database
  namespace: bookstore-app
  labels:
    app: database
spec:
  ports:
  - port: 5432
    name: postgres
  selector:
    app: database
EOF

# Apply the database configuration
oc apply -f database-deployment.yaml
Subtask 1.3: Deploy the Books Service
Deploy the books microservice that manages book inventory.

# Create the books service deployment
cat << 'EOF' > books-service.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: books-service
  namespace: bookstore-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: books-service
      version: v1
  template:
    metadata:
      labels:
        app: books-service
        version: v1
    spec:
      containers:
      - name: books-service
        image: quay.io/redhat-training/books-service:1.0
        ports:
        - containerPort: 8080
        env:
        - name: DATABASE_URL
          value: "postgresql://bookuser:bookpass123@database:5432/bookstore"
        - name: SERVICE_NAME
          value: "books-service"
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "256Mi"
            cpu: "200m"
        livenessProbe:
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /ready
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: books-service
  namespace: bookstore-app
  labels:
    app: books-service
spec:
  ports:
  - port: 8080
    name: http
  selector:
    app: books-service
EOF

# Apply the books service configuration
oc apply -f books-service.yaml
