Task 1: Configure Egress Gateway
Subtask 1.1: Deploy Sample Application
First, we'll deploy a sample application that will make external requests:

# Create a sample application deployment
cat << 'EOF' > sample-app.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: sample-app
  namespace: egress-lab
spec:
  replicas: 1
  selector:
    matchLabels:
      app: sample-app
  template:
    metadata:
      labels:
        app: sample-app
    spec:
      containers:
      - name: sample-app
        image: curlimages/curl:latest
        command: ["/bin/sh"]
        args: ["-c", "while true; do sleep 3600; done"]
---
apiVersion: v1
kind: Service
metadata:
  name: sample-app
  namespace: egress-lab
spec:
  selector:
    app: sample-app
  ports:
  - port: 80
    targetPort: 80
EOF

# Apply the deployment
oc apply -f sample-app.yaml

# Wait for the pod to be ready
oc wait --for=condition=ready pod -l app=sample-app -n egress-lab --timeout=300s
Subtask 1.2: Test Default Egress Behavior
Let's test the current egress behavior before implementing controls:

# Get the pod name
POD_NAME=$(oc get pods -n egress-lab -l app=sample-app -o jsonpath='{.items[0].metadata.name}')

# Test external connectivity (this should work by default)
oc exec -n egress-lab $POD_NAME -- curl -s -o /dev/null -w "%{http_code}" http://httpbin.org/get

# Test HTTPS connectivity
oc exec -n egress-lab $POD_NAME -- curl -s -o /dev/null -w "%{http_code}" https://httpbin.org/get
Subtask 1.3: Create ServiceEntry for External Service
Now we'll create a ServiceEntry to register an external service:

# Create ServiceEntry for httpbin.org
cat << 'EOF' > httpbin-serviceentry.yaml
apiVersion: networking.istio.io/v1beta1
kind: ServiceEntry
metadata:
  name: httpbin-ext
  namespace: egress-lab
spec:
  hosts:
  - httpbin.org
  ports:
  - number: 80
    name: http
    protocol: HTTP
  - number: 443
    name: https
    protocol: HTTPS
  location: MESH_EXTERNAL
  resolution: DNS
EOF

# Apply the ServiceEntry
oc apply -f httpbin-serviceentry.yaml

# Verify the ServiceEntry
oc get serviceentry -n egress-lab
Subtask 1.4: Configure Egress Gateway
Create and configure the egress gateway:

# Create Gateway configuration for egress
cat << 'EOF' > egress-gateway.yaml
apiVersion: networking.istio.io/v1beta1
kind: Gateway
metadata:
  name: istio-egressgateway
  namespace: egress-lab
spec:
  selector:
    istio: egressgateway
  servers:
  - port:
      number: 80
      name: http
      protocol: HTTP
    hosts:
    - httpbin.org
  - port:
      number: 443
      name: https
      protocol: HTTPS
    hosts:
    - httpbin.org
    tls:
      mode: PASSTHROUGH
EOF

# Apply the Gateway configuration
oc apply -f egress-gateway.yaml

# Verify the Gateway
oc get gateway -n egress-lab
Subtask 1.5: Create VirtualService for Egress Traffic
Configure routing through the egress gateway:

# Create VirtualService for egress routing
cat << 'EOF' > egress-virtualservice.yaml
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: direct-httpbin-through-egress-gateway
  namespace: egress-lab
spec:
  hosts:
  - httpbin.org
  gateways:
  - istio-egressgateway
  - mesh
  http:
  - match:
    - gateways:
      - mesh
      port: 80
    route:
    - destination:
        host: istio-egressgateway.istio-system.svc.cluster.local
        port:
          number: 80
      weight: 100
  - match:
    - gateways:
      - istio-egressgateway
      port: 80
    route:
    - destination:
        host: httpbin.org
        port:
          number: 80
      weight: 100
---
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: direct-httpbin-through-egress-gateway-tls
  namespace: egress-lab
spec:
  hosts:
  - httpbin.org
  gateways:
  - istio-egressgateway
  - mesh
  tls:
  - match:
    - gateways:
      - mesh
      port: 443
      sniHosts:
      - httpbin.org
    route:
    - destination:
        host: istio-egressgateway.istio-system.svc.cluster.local
        port:
          number: 443
  - match:
    - gateways:
      - istio-egressgateway
      port: 443
      sniHosts:
      - httpbin.org
    route:
    - destination:
        host: httpbin.org
        port:
          number: 443
EOF

# Apply the VirtualService
oc apply -f egress-virtualservice.yaml

# Verify the VirtualService
oc get virtualservice -n egress-lab
Task 2: Set Up Policies for Outbound Traffic Management
Subtask 2.1: Create DestinationRule for External Service
Configure destination rules for traffic policies:

# Create DestinationRule for httpbin.org
cat << 'EOF' > httpbin-destinationrule.yaml
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: httpbin-ext
  namespace: egress-lab
spec:
  host: httpbin.org
  trafficPolicy:
    connectionPool:
      tcp:
        maxConnections: 10
      http:
        http1MaxPendingRequests: 10
        maxRequestsPerConnection: 2
    circuitBreaker:
      consecutiveErrors: 3
      interval: 30s
      baseEjectionTime: 30s
EOF

# Apply the DestinationRule
oc apply -f httpbin-destinationrule.yaml

# Verify the DestinationRule
oc get destinationrule -n egress-lab
Subtask 2.2: Implement Egress Network Policy
Create network policies to control egress traffic:

# Create Istio AuthorizationPolicy for egress control
cat << 'EOF' > egress-authz-policy.yaml
apiVersion: security.istio.io/v1beta1
kind: AuthorizationPolicy
metadata:
  name: allow-egress-httpbin
  namespace: egress-lab
spec:
  selector:
    matchLabels:
      app: sample-app
  action: ALLOW
  rules:
  - to:
    - operation:
        hosts: ["httpbin.org"]
        methods: ["GET", "POST"]
EOF

# Apply the AuthorizationPolicy
oc apply -f egress-authz-policy.yaml

# Verify the policy
oc get authorizationpolicy -n egress-lab
Subtask 2.3: Configure Sidecar for Egress Control
Create a Sidecar configuration to control egress traffic:

# Create Sidecar configuration
cat << 'EOF' > egress-sidecar.yaml
apiVersion: networking.istio.io/v1beta1
kind: Sidecar
metadata:
  name: default
  namespace: egress-lab
spec:
  egress:
  - hosts:
    - "./*"
    - "istio-system/*"
    - "./httpbin.org"
EOF

# Apply the Sidecar configuration
oc apply -f egress-sidecar.yaml

# Verify the Sidecar
oc get sidecar -n egress-lab
Subtask 2.4: Create Rate Limiting Policy
Implement rate limiting for external services:

# Create EnvoyFilter for rate limiting
cat << 'EOF' > rate-limit-filter.yaml
apiVersion: networking.istio.io/v1alpha3
kind: EnvoyFilter
metadata:
  name: httpbin-ratelimit
  namespace: egress-lab
spec:
  workloadSelector:
    labels:
      app: sample-app
  configPatches:
  - applyTo: HTTP_FILTER
    match:
      context: SIDECAR_INBOUND
      listener:
        filterChain:
          filter:
            name: "envoy.filters.network.http_connection_manager"
    patch:
      operation: INSERT_BEFORE
      value:
        name: envoy.filters.http.local_ratelimit
        typed_config:
          "@type": type.googleapis.com/udpa.type.v1.TypedStruct
          type_url: type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit
          value:
            stat_prefix: httpbin_rate_limiter
            token_bucket:
              max_tokens: 10
              tokens_per_fill: 10
              fill_interval: 60s
            filter_enabled:
              runtime_key: local_rate_limit_enabled
              default_value:
                numerator: 100
                denominator: HUNDRED
            filter_enforced:
              runtime_key: local_rate_limit_enforced
              default_value:
                numerator: 100
                denominator: HUNDRED
EOF

# Apply the EnvoyFilter
oc apply -f rate-limit-filter.yaml

# Verify the EnvoyFilter
oc get envoyfilter -n egress-lab
Task 3: Test External Service Communication from the Mesh
Subtask 3.1: Test Basic Connectivity
Test the configured egress traffic routing:

# Get the updated pod name
POD_NAME=$(oc get pods -n egress-lab -l app=sample-app -o jsonpath='{.items[0].metadata.name}')

# Test HTTP connectivity through egress gateway
echo "Testing HTTP connectivity..."
oc exec -n egress-lab $POD_NAME -- curl -s -o /dev/null -w "HTTP Status: %{http_code}, Time: %{time_total}s\n" http://httpbin.org/get

# Test HTTPS connectivity
echo "Testing HTTPS connectivity..."
oc exec -n egress-lab $POD_NAME -- curl -s -o /dev/null -w "HTTP Status: %{http_code}, Time: %{time_total}s\n" https://httpbin.org/get

# Test with headers to verify routing
echo "Testing with custom headers..."
oc exec -n egress-lab $POD_NAME -- curl -s -H "X-Test: egress-lab" http://httpbin.org/headers
Subtask 3.2: Verify Traffic Routing Through Egress Gateway
Check that traffic is actually going through the egress gateway:

# Check egress gateway logs
echo "Checking egress gateway logs..."
oc logs -n istio-system -l istio=egressgateway --tail=20

# Generate some traffic and check logs again
echo "Generating test traffic..."
for i in {1..5}; do
  oc exec -n egress-lab $POD_NAME -- curl -s -o /dev/null http://httpbin.org/get
  sleep 1
done

# Check logs again
echo "Checking egress gateway logs after traffic..."
oc logs -n istio-system -l istio=egressgateway --tail=10
Subtask 3.3: Test Rate Limiting
Verify that rate limiting is working:

# Test rate limiting by making rapid requests
echo "Testing rate limiting..."
for i in {1..15}; do
  echo "Request $i:"
  oc exec -n egress-lab $POD_NAME -- curl -s -o /dev/null -w "HTTP Status: %{http_code}\n" http://httpbin.org/get
  sleep 1
done
Subtask 3.4: Test Blocked External Services
Test that non-configured external services are blocked:

# Try to access a service not in ServiceEntry
echo "Testing blocked external service..."
oc exec -n egress-lab $POD_NAME -- curl -s -o /dev/null -w "HTTP Status: %{http_code}\n" --connect-timeout 10 http://google.com

# This should fail or timeout since google.com is not in our ServiceEntry
Subtask 3.5: Monitor Egress Traffic with Kiali
Access monitoring and observability:

# Get Kiali route (if available)
oc get route kiali -n istio-system

# Generate traffic for monitoring
echo "Generating traffic for monitoring..."
for i in {1..10}; do
