Troubleshooting Common Issues
Issue 1: Traces Not Appearing
Symptoms: No traces visible in Jaeger UI

Solutions:

# Check if Jaeger collector is receiving traces
kubectl logs -n istio-system deployment/jaeger-small-production-collector

# Verify Istio proxy configuration
kubectl exec -n bookinfo deployment/productpage-v1 -c istio-proxy -- curl localhost:15000/config_dump | grep tracing

# Check sampling configuration
kubectl get configmap istio -n istio-system -o yaml | grep -A 10 tracing
Issue 2: High Memory Usage
Symptoms: Jaeger components consuming excessive memory

Solutions:

# Adjust resource limits
kubectl patch jaeger jaeger-small-production -n istio-system --type='merge' -p='{"spec":{"collector":{"resources":{"limits":{"memory":"512Mi"}}}}}'

# Reduce trace retention period
kubectl patch jaeger jaeger-small-production -n istio-system --type='merge' -p='{"spec":{"storage":{"options":{"es.index.cleaner.enabled":"true","es.index.cleaner.num-days":"7"}}}}'
Issue 3: Missing Service Dependencies
Symptoms: Services not showing in dependency graph

Solutions:

# Ensure proper service mesh injection
kubectl get pods -n bookinfo -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.containers[*].name}{"\n"}{end}' | grep istio-proxy

# Check if services are properly configured
kubectl get destinationrules -n bookinfo
kubectl get virtualservices -n bookinfo
Performance Optimization Tips
Optimize Trace Collection
# Configure adaptive sampling
cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: adaptive-sampling-config
  namespace: istio-system
data:
  sampling_strategies.json: |
    {
      "default_strategy": {
        "type": "adaptive",
        "max_traces_per_second": 100
      }
    }
EOF
Reduce Storage Requirements
# Configure index lifecycle management
kubectl patch jaeger jaeger-small-production -n istio-system --type='merge' -p='{"spec":{"storage":{"options":{"es.index.settings":"{\"index.number_of_replicas\":0}"}}}}'
