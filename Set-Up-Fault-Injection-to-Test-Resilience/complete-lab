Troubleshooting Common Issues
Issue 1: Fault Injection Not Working
Problem: Fault injection policies are not taking effect.

Solution:

# Check if virtual services are applied correctly
kubectl get virtualservices -n bookinfo

# Verify destination rules
kubectl get destinationrules -n bookinfo

# Check Istio proxy configuration
kubectl exec -n bookinfo deployment/productpage-v1 -c istio-proxy -- pilot-agent request GET config_dump
Issue 2: Gateway URL Not Accessible
Problem: Cannot access the application through the gateway.

Solution:

# Check ingress gateway status
kubectl get svc -n istio-system istio-ingressgateway

# Verify gateway configuration
kubectl get gateway -n bookinfo

# Check if using NodePort instead of LoadBalancer
export INGRESS_PORT=$(kubectl -n istio-system get service istio-ingressgateway -o jsonpath='{.spec.ports[?(@.name=="http2")].nodePort}')
export INGRESS_HOST=$(kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type=="ExternalIP")].address}')
Issue 3: Monitoring Tools Not Accessible
Problem: Cannot access Grafana, Jaeger, or Prometheus.

Solution:

# Check if monitoring tools are running
kubectl get pods -n istio-system | grep -E "(grafana|jaeger|prometheus)"

# Kill existing port forwards and restart
pkill -f "kubectl port-forward"
kubectl port-forward -n istio-system svc/grafana 3000:3000 &
kubectl port-forward -n istio-system svc/jaeger 16686:16686 &
kubectl port-forward -n istio-system svc/prometheus 9090:9090 &
