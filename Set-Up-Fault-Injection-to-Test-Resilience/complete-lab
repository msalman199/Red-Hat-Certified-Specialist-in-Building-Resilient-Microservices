Subtask 2.3: Configure Advanced Fault Scenarios
Create percentage-based fault injection:
cat > percentage-fault.yaml << 'EOF'
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: reviews-percentage-fault
  namespace: bookinfo
spec:
  hosts:
  - reviews
  http:
  - fault:
      delay:
        percentage:
          value: 50.0
        fixedDelay: 3s
      abort:
        percentage:
          value: 10.0
        httpStatus: 503
    route:
    - destination:
        host: reviews
        subset: v1
EOF
kubectl apply -f percentage-fault.yaml
Test percentage-based faults:
cat > test-percentage-faults.sh << 'EOF'
#!/bin/bash
echo "Testing percentage-based fault injection (50% delay, 10% abort)..."
success=0
delayed=0
failed=0

for i in {1..20}; do
  start_time=$(date +%s.%N)
  status=$(curl -s -o /dev/null -w "%{http_code}" "http://$GATEWAY_URL/productpage")
  end_time=$(date +%s.%N)
  duration=$(echo "$end_time - $start_time" | bc)
  
  if [ "$status" = "200" ]; then
    if (( $(echo "$duration > 2.5" | bc -l) )); then
      delayed=$((delayed + 1))
      echo "Request $i: SUCCESS with DELAY (${duration}s)"
    else
      success=$((success + 1))
      echo "Request $i: SUCCESS (${duration}s)"
    fi
  else
    failed=$((failed + 1))
    echo "Request $i: FAILED ($status)"
  fi
done

echo
echo "Results:"
echo "  Successful: $success"
echo "  Delayed: $delayed"
echo "  Failed: $failed"
EOF

chmod +x test-percentage-faults.sh
./test-percentage-faults.sh
Task 3: Monitor Resilience Mechanisms
Subtask 3.1: Configure Retry Policies
Create a retry policy configuration:
cat > retry-policy.yaml << 'EOF'
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: reviews-retry
  namespace: bookinfo
spec:
  hosts:
  - reviews
  http:
  - fault:
      abort:
        percentage:
          value: 50.0
        httpStatus: 503
    route:
    - destination:
        host: reviews
        subset: v1
    retries:
      attempts: 3
      perTryTimeout: 2s
      retryOn: 5xx,reset,connect-failure,refused-stream
EOF
kubectl apply -f retry-policy.yaml
Test retry mechanism:
cat > test-retries.sh << 'EOF'
